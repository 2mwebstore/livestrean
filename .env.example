# Copy to .env and fill in. Generate secrets with: openssl rand -hex 24

# --- Site -------------------------------------------------------------------
APP_ENV=development
# Public address of the site. https:// turns on secure cookies.
APP_URL=http://localhost:8080
# What Caddy serves: ":80" locally, your domain in production (gets HTTPS).
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Only when another proxy (e.g. Cloudflare) sits in front of Caddy: its IP
# ranges and the header it puts the visitor's IP in. Default: trust nobody.
# TRUSTED_PROXIES=173.245.48.0/20 103.21.244.0/22 ...
# CLIENT_IP_HEADERS=CF-Connecting-IP

# --- Streaming ----------------------------------------------------------------
# RTMP server shown to streamers in their dashboard (OBS "Server" field).
PUBLIC_RTMP_URL=rtmp://localhost/live
# Comma-separated IPs/hostnames viewers use to reach this machine over WebRTC
# (Low latency mode): 127.0.0.1 plus your LAN IP locally, the public IP on a server.
PUBLIC_HOST=127.0.0.1
MAX_CHANNELS_PER_USER=5

# --- Database -----------------------------------------------------------------
DB_NAME=livestream
DB_USER=livestream
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- First admin account, created on first start ------------------------------
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
# At least 12 characters. Changing it later does not reset an existing account.
ADMIN_PASSWORD=change-me-please
