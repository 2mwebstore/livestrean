# Single entry point: website, API, WebSocket and video all share one origin,
# so the session cookie works everywhere and no CORS is needed.
#
# SITE_ADDRESS: ":80" locally, a domain name in production (automatic HTTPS),
# or ":<port>" behind a platform proxy such as Railway.
# *_UPSTREAM: where each service is reachable (Docker Compose names by default).
# The backend and frontend get the visitor's IP in X-Real-IP.
{
	admin off
	servers {
		# Proxies in front of Caddy whose client-IP header may be believed, e.g.
		# a platform edge such as Railway's. Default: none, because Caddy faces
		# the internet directly and anyone could send a fake header.
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
		client_ip_headers {$CLIENT_IP_HEADERS:X-Forwarded-For}
	}
}

{$SITE_ADDRESS::80} {
	# WebRTC signalling: OBS WHIP publish and browser WHEP playback
	@webrtc path_regexp ^/live/[^/]+/(whip|whep)(/.*)?$
	handle @webrtc {
		reverse_proxy {$MEDIAMTX_WEBRTC_UPSTREAM:mediamtx:8889} {
			# Give MediaMTX the viewer's real IP (for its logs and session checks).
			header_up X-Forwarded-For {client_ip}
		}
	}

	# HLS playlists and segments
	handle /live/* {
		reverse_proxy {$MEDIAMTX_HLS_UPSTREAM:mediamtx:8888} {
			# MediaMTX ties HLS sessions to the viewer's IP, so send the real one.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /api/* {
		reverse_proxy {$BACKEND_UPSTREAM:backend:8080} {
			header_up X-Real-IP {client_ip}
		}
	}

	handle /ws/* {
		reverse_proxy {$BACKEND_UPSTREAM:backend:8080} {
			header_up X-Real-IP {client_ip}
		}
	}

	# Everything else is the Nuxt website
	handle {
		encode zstd gzip
		reverse_proxy {$FRONTEND_UPSTREAM:frontend:3000} {
			header_up X-Real-IP {client_ip}
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Only /embed/* pages may be shown inside other websites' iframes.
	@notEmbed not path /embed/*
	header @notEmbed X-Frame-Options SAMEORIGIN
}
